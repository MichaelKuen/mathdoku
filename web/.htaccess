# Flutter web build for /play/mathdoku/

# Correct MIME types
AddType application/wasm .wasm
AddType application/javascript .js
AddType text/javascript .mjs
AddType application/json .json
AddType font/otf .otf
AddType font/ttf .ttf
AddType font/woff .woff
AddType font/woff2 .woff2

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript
  AddOutputFilterByType DEFLATE application/wasm application/json
  AddOutputFilterByType DEFLATE font/otf font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Flutter does not put content hashes in its file names (main.dart.js,
  # flutter_bootstrap.js, assets/...), so files must be revalidated on every
  # load. Never use "immutable" or long expiry here, or players get stuck on
  # an old build. Unchanged files still come back as a quick 304.
  <FilesMatch "\.(html|js|mjs|wasm|json|bin|otf|ttf|woff|woff2|frag|png|ico|symbols)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # The entry page is never stored.
  <FilesMatch "^(index\.html)?$">
    Header set Cache-Control "no-store, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
